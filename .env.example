# ── Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER exposed to the browser. Used for
# Edge Functions / admin scripts (e.g. inviting a user to a firm).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Used only by `npm run db:types` to pull typed schema from your project.
SUPABASE_PROJECT_ID=your-project-ref

# ── AI (OpenAI, swappable — see lib/ai/) ────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Payments (not yet wired up — see Status in README) ────────────────────
# Paystack/Flutterwave live checkout is intentionally not built yet.
# Payments are currently recorded manually from the invoice page. These are
# here for when that integration gets picked up — safe to leave blank.
# Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
# Flutterwave dashboard → Settings → API
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...

# ── App ──────────────────────────────────────────────────────────────────
# Used in the "email to client" mailto link (invoice) to point at the
# client portal, and should match wherever you actually deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000
